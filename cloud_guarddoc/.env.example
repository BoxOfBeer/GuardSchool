GUARDSCHOOL_DATA_DIR=/var/lib/guardschool/data
GUARDSCHOOL_DATABASE_URL=postgresql://guardschool:CHANGE@127.0.0.1/guardschool
GUARDSCHOOL_SYNC_TOKEN=change-me-long-random
GUARDSCHOOL_TV_BEARER_TOKEN=change-me-tv-token
GUARDSCHOOL_SAAS_MODE=1
# Единый вход всех школ на одном домене (не {slug}.guarddoc.ru): Host совпадает с этим значением,
# slug школы после логина хранится в cookie gs_saas_tenant. Пример: school.guarddoc.ru
# GUARDSCHOOL_PUBLIC_SCHOOL_HOST=school.guarddoc.ru
# GUARDSCHOOL_PUBLIC_SCHOOL_SCHEME=https
GUARDSCHOOL_ADMIN_USERNAME=admin
GUARDSCHOOL_ADMIN_PASSWORD=ChangeMe123
# GUARDSCHOOL_SKIP_SAAS_BOOTSTRAP=1
# Опционально: GUARDSCHOOL_SAAS_MAX_SCHEDULE_XLSX_BYTES=15728640
# GUARDSCHOOL_SAAS_MAX_SCHEDULE_JSON_BYTES=1048576
# GUARDSCHOOL_SAAS_MAX_USER_DATA_BYTES=15728640
# Портал / ADM (лицензии): один из вариантов
# GUARDSCHOOL_PORTAL_ADM_USERNAME=provider
# GUARDSCHOOL_PORTAL_ADM_PASSWORD=ChangeMe123
# GUARDSCHOOL_PROVIDER_ADMIN_TOKEN=long-random-bearer
# Демо: скопировать uploads и break_music из эталонного data (абсолютный путь)
# GUARDSCHOOL_TRY_DEMO_LIBRARY_DIR=/var/lib/guardschool/tenants/school/data
# Срок новой лицензии по умолчанию (лет), если в POST не передали expires_years / expires_days
# GUARDSCHOOL_LICENSE_DEFAULT_TERM_YEARS=1
